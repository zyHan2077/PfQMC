--- a/inc/skewMatUtils.h
+++ b/inc/skewMatUtils.h
@@ -4,6 +4,16 @@
 #include "types.h"
 #include<iostream>
 #include "../inc/pfapack/c_interface/pfapack.h"
+
+// Unconjugated antisymmetric rank-two update. Fuse the two matrix traversals;
+// x and y must be independent copies, not views into g.
+inline void skewRank2Update(MatType& g, const cVecType& x,
+                           const cVecType& y, DataType alpha) {
+    for (int j = 0; j < g.cols(); ++j) {
+        const DataType a = alpha * y(j), b = alpha * x(j);
+        g.col(j) += x*a - y*b;
+    }
+}
 
